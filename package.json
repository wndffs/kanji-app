{
  "name": "kanji-srs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev --workspace @kanji-srs/api\" \"npm run dev --workspace @kanji-srs/web\"",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run prisma:generate --workspace @kanji-srs/db",
    "db:curate": "npm run prisma:curate-main-course --workspace @kanji-srs/db --",
    "db:curate:words": "npm run prisma:curate-main-course-words --workspace @kanji-srs/db --",
    "db:publish:pilot": "npm run prisma:publish-foundation-pilot --workspace @kanji-srs/db --",
    "db:restore:verify": "npm run prisma:verify-database-restore --workspace @kanji-srs/db --",
    "content:quality": "npm run prisma:report-content-quality --workspace @kanji-srs/db --",
    "content:inventory": "npm run prisma:report-editorial-registry --workspace @kanji-srs/db --",
    "content:drafts:evidence": "npm run prisma:report-editorial-draft-evidence --workspace @kanji-srs/db --",
    "content:drafts:local": "tsx scripts/inspect-local-draft-sources.mts",
    "content:drafts:preview": "npm run prisma:preview-editorial-drafts --workspace @kanji-srs/db --",
    "content:coverage": "npm run prisma:report-editorial-coverage --workspace @kanji-srs/db --",
    "content:wave": "npm run prisma:report-editorial-wave --workspace @kanji-srs/db --",
    "db:migrate": "npm run prisma:migrate:dev --workspace @kanji-srs/db",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @kanji-srs/db",
    "db:seed": "npm run prisma:seed --workspace @kanji-srs/db",
    "import:jmdict": "npm run import:jmdict --workspace @kanji-srs/content-importers --",
    "import:kanjidic2": "npm run import:kanjidic2 --workspace @kanji-srs/content-importers --",
    "import:kanjivg": "npm run import:kanjivg --workspace @kanji-srs/content-importers --",
    "import:tatoeba": "npm run import:tatoeba --workspace @kanji-srs/content-importers --",
    "content:snapshot": "node scripts/prepare-content-snapshot.mjs",
    "content:report": "npm run report:corpus --workspace @kanji-srs/content-importers --",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:source-tools": "tsc -p tsconfig.source-tools.json",
    "test": "npm run test --workspaces --if-present",
    "smoke:remote": "node scripts/remote-smoke.mjs",
    "measure:web:bundles": "node scripts/measure-web-bundles.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@next/eslint-plugin-next": "^16.4.2",
    "@types/node": "^22.15.32",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "concurrently": "^9.2.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "saxes": "6.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1",
    "vitest": "^5.0.5"
  }
}
