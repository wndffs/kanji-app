{
  "name": "@kanji-srs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:curate-main-course": "tsx prisma/curate-main-course.ts",
    "prisma:curate-main-course-words": "tsx prisma/curate-main-course-words.ts",
    "prisma:publish-foundation-pilot": "tsx prisma/publish-foundation-pilot.ts",
    "prisma:verify-database-restore": "tsx prisma/verify-database-restore.ts",
    "prisma:report-content-quality": "tsx prisma/report-content-quality.ts",
    "prisma:report-editorial-registry": "tsx prisma/report-editorial-registry.ts",
    "prisma:report-editorial-draft-evidence": "tsx prisma/report-editorial-draft-evidence.ts",
    "prisma:preview-editorial-drafts": "tsx prisma/preview-editorial-drafts.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kanji-srs/japanese": "0.0.0",
    "@kanji-srs/shared": "0.0.0",
    "@prisma/client": "^6.18.0"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "prisma": "^6.18.0"
  }
}
